# Keep MATLAB sources byte-identical to the working copies (many files use
# CRLF line endings and Latin-1 encoded umlauts).
*.m        -text diff
*.inp      -text
*.tex      text eol=lf
README.md  text eol=lf
*.bib      text eol=lf
*.yml      text eol=lf
*.cff      text eol=lf
*.mat      binary
*.pdf      binary
*.png      binary

# GitHub language statistics: .m is MATLAB (not Objective-C or Mathematica)
*.m        linguist-language=MATLAB
