# Keep MATLAB sources byte-identical to the working copies (many files use
# CRLF line endings and Latin-1 encoded umlauts).
*.m        -text diff
*.inp      -text
*.tex      text eol=lf
README.md  text eol=lf
*.bib      text eol=lf
*.yml      text eol=lf
*.cff      text eol=lf
*.mat      binary
*.pdf      binary
*.nb       binary
*.png      binary

# GitHub language statistics: .m is MATLAB (not Objective-C or Mathematica),
# and the single Mathematica derivation notebook (~1 MB, as large as all .m
# files together) is supporting material, not part of the code base.
*.m        linguist-language=MATLAB
*.nb       linguist-detectable=false
