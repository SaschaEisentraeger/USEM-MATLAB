Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"Factorial", "[", "x", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"padeP", "[", 
   RowBox[{"L_", ",", "M_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"(", 
         RowBox[{"M", "+", "L", "-", "i"}], ")"}], "]"}], "/", 
       RowBox[{"f", "[", "i", "]"}]}], "/", 
      RowBox[{"f", "[", 
       RowBox[{"L", "-", "i"}], "]"}]}], "*", 
     RowBox[{"x", "^", "i"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "L"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"padeQ", "[", 
   RowBox[{"L_", ",", "M_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "M", "]"}], "/", 
    RowBox[{"f", "[", "L", "]"}]}], "*", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"(", 
          RowBox[{"M", "+", "L", "-", "i"}], ")"}], "]"}], "/", 
        RowBox[{"f", "[", "i", "]"}]}], "/", 
       RowBox[{"f", "[", 
        RowBox[{"M", "-", "i"}], "]"}]}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "x"}], ")"}], "^", "i"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "M"}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "[", 
   RowBox[{"L_", ",", "M_", ",", "a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"a", "*", 
    RowBox[{"padeP", "[", 
     RowBox[{"M", ",", "M", ",", "x"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "a"}], ")"}], "*", 
    RowBox[{"padeP", "[", 
     RowBox[{"L", ",", "M", ",", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", "[", 
   RowBox[{"L_", ",", "M_", ",", "a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"a", "*", 
    RowBox[{"padeQ", "[", 
     RowBox[{"M", ",", "M", ",", "x"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "a"}], ")"}], "*", 
    RowBox[{"padeQ", "[", 
     RowBox[{"L", ",", "M", ",", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PQ", "[", 
   RowBox[{"L_", ",", "M_", ",", "a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"L", ",", "M", ",", "a", ",", "x"}], "]"}], "/", 
   RowBox[{"Q", "[", 
    RowBox[{"L", ",", "M", ",", "a", ",", "x"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho", "[", 
   RowBox[{"L_", ",", "M_", ",", "a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Abs", "[", 
   RowBox[{"PQ", "[", 
    RowBox[{"L", ",", "M", ",", "a", ",", 
     RowBox[{"2", "*", "Pi", "*", "x", "*", "\[ImaginaryI]"}]}], "]"}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"myArg", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Im", "[", "x", "]"}], "<", "0"}], ",", 
    RowBox[{
     RowBox[{"Arg", "[", "x", "]"}], "+", 
     RowBox[{"2", "*", "Pi"}]}], ",", 
    RowBox[{"Arg", "[", "x", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"arg", "[", 
   RowBox[{"L_", ",", "M_", ",", "a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"myArg", "[", 
   RowBox[{"PQ", "[", 
    RowBox[{"L", ",", "M", ",", "a", ",", 
     RowBox[{"2", "*", "Pi", "*", "x", "*", "\[ImaginaryI]"}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pE", "[", 
   RowBox[{"L_", ",", "M_", ",", "a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"2", "*", "Pi", "*", 
    RowBox[{"x", "/", 
     RowBox[{"arg", "[", 
      RowBox[{"L", ",", "M", ",", "a", ",", "x"}], "]"}]}]}], "-", 
   "1"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dR", "[", 
   RowBox[{"L_", ",", "M_", ",", "a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Log", "[", 
     RowBox[{"rho", "[", 
      RowBox[{"L", ",", "M", ",", "a", ",", "x"}], "]"}], "]"}]}], "/", 
   RowBox[{"arg", "[", 
    RowBox[{"L", ",", "M", ",", "a", ",", "x"}], "]"}]}]}]}], "Input",
